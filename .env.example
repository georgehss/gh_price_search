# ==========================================
# GH Price Search & Deal Bot - Configuração
# ==========================================

# Chave de API do Google Gemini (para análise inteligente de custo-benefício)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=

# Chave de API do CallMeBot para WhatsApp
# Para obter sua chave gratuita do CallMeBot para WhatsApp:
# 1. Adicione o número +34 644 44 49 43 ou +34 644 20 82 14 aos seus contatos do WhatsApp.
# 2. Envie a mensagem: "I allow callmebot to send me messages" para ele.
# 3. Ele responderá com sua apikey.
CALLMEBOT_API_KEY=

# Número padrão de WhatsApp com código do país (Ex: +5511999999999)
# O telefone também pode ser configurado e alterado diretamente pelo Painel Web.
DEFAULT_PHONE=

# Intervalo padrão de monitoramento em minutos (padrão: 60)
CHECK_INTERVAL_MINUTES=60
